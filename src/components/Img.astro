---
// Фото из public/img: имя без папки — блюдо из img/food, 'loc/…' — фото точки. Две ширины webp.
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { name, alt, sizes = '(max-width: 700px) 100vw, 400px', eager = false, class: cls } = Astro.props;
const base = `/img/${name.includes('/') ? name : `food/${name}`}`;
---
<img class={cls} src={`${base}-1200.webp`} srcset={`${base}-640.webp 640w, ${base}-1200.webp 1200w`} sizes={sizes} alt={alt} width="1200" height="900" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
